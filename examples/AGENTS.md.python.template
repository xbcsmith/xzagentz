python -m pytest                    # Verify tests pass
ruff check src/                     # Verify no lint errors
markdownlint --fix docs/**/*.md     # Fix docs if changed

# Commit
git add .
git commit -m "feat(module): add feature (xbcsmith-1234)"
git push origin pr-xbcsmith-1234
```

### File Validation

````bash
# Check markdown filename format
basename file.md | grep -E '^[a-z_]+\.md$|^README\.md$'

# Check for missing code block languages
grep -n '^```$' file.md

# Check for .yml files (should use .yaml)
find . -name "*.yml"

# Lint markdown
markdownlint --fix --config .markdownlint.json docs/file.md
````

### Python Environment

```bash
# Create venv
python3 -m venv .venv/@project-name@

# Activate
source .venv/@project-name@/bin/activate

# Install
pip install -e ".[dev]"

# Verify
which python
python -c "import @project-name@; print(@project-name@.__file__)"
```

